# Fastlane 설정
# iOS 및 Android 앱 빌드 및 배포
# 빌드 번호는 app.json에서 관리되며, expo prebuild 시 자동으로 적용됩니다

# iOS 플랫폼
platform :ios do
  desc "TestFlight에 새 베타 빌드 업로드"
  lane :beta do
    # Xcode 버전 선택
    xcversion(version: "26.0.1")
    
    # 인증서 및 프로비저닝 프로파일 관리
    setup_ci if ENV['CI']
    
    match(
      type: "appstore",
      app_identifier: "dev.eatsteak.ssurf",
      readonly: is_ci,
      git_url: ENV["MATCH_GIT_URL"],
      git_basic_authorization: ENV["MATCH_GIT_BASIC_AUTHORIZATION"]
    )

    # 앱 빌드
    gym(
      scheme: "ssurf",
      workspace: "./ios/ssurf.xcworkspace",
      export_method: "app-store",
      export_options: {
        provisioningProfiles: {
          "dev.eatsteak.ssurf" => "match AppStore dev.eatsteak.ssurf"
        }
      },
      output_directory: "./build",
      output_name: "ssurf.ipa"
    )

    # App Store Connect API Key 설정
    api_key = app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
      key_content: ENV["APP_STORE_CONNECT_KEY_CONTENT"],
      is_key_content_base64: true,
      duration: 1200,
      in_house: false
    )

    # TestFlight에 업로드
    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true,
      skip_submission: true,
      distribute_external: false,
      changelog: ENV["CHANGELOG"] || "버그 수정 및 개선 사항"
    )

    UI.success("✅ TestFlight 업로드 완료!")
  end

  desc "프로덕션 빌드를 App Store에 배포"
  lane :release do
    # Xcode 버전 선택
    xcversion(version: "16.0.1")
    
    # 인증서 및 프로비저닝 프로파일 관리
    setup_ci if ENV['CI']
    
    match(
      type: "appstore",
      app_identifier: "dev.eatsteak.ssurf",
      readonly: is_ci,
      git_url: ENV["MATCH_GIT_URL"],
      git_basic_authorization: ENV["MATCH_GIT_BASIC_AUTHORIZATION"]
    )

    # 앱 빌드
    gym(
      scheme: "ssurf",
      workspace: "./ios/ssurf.xcworkspace",
      export_method: "app-store",
      export_options: {
        provisioningProfiles: {
          "dev.eatsteak.ssurf" => "match AppStore dev.eatsteak.ssurf"
        }
      },
      output_directory: "./build",
      output_name: "ssurf.ipa"
    )

    # App Store Connect API Key 설정
    api_key = app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
      key_content: ENV["APP_STORE_CONNECT_KEY_CONTENT"],
      is_key_content_base64: true,
      duration: 1200,
      in_house: false
    )

    # App Store에 업로드 (수동 심사 제출)
    upload_to_app_store(
      api_key: api_key,
      skip_metadata: true,
      skip_screenshots: true,
      skip_binary_upload: false,
      submit_for_review: false,
      automatic_release: false,
      precheck_include_in_app_purchases: false
    )

    UI.success("✅ App Store 업로드 완료! App Store Connect에서 수동으로 심사 제출하세요.")
  end
end

# Android 플랫폼
platform :android do
  desc "Google Play Console Internal Testing 트랙에 새 빌드 업로드"
  lane :internal do
    # AAB 빌드
    gradle(
      task: "bundle",
      build_type: "Release",
      project_dir: "./android"
    )

    # Google Play Console에 업로드 (Internal Testing 트랙)
    upload_to_play_store(
      track: 'internal',
      aab: lane_context[SharedValues::GRADLE_AAB_OUTPUT_PATH],
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      skip_upload_apk: true,
      json_key_data: ENV["GOOGLE_PLAY_SERVICE_ACCOUNT_JSON"],
      package_name: "dev.eatsteak.ssurf",
      release_status: "completed"
    )

    UI.success("✅ Internal Testing 업로드 완료!")
  end

  desc "Google Play Console Beta 트랙에 배포"
  lane :beta do
    # AAB 빌드
    gradle(
      task: "bundle",
      build_type: "Release",
      project_dir: "./android"
    )

    # Google Play Console에 업로드 (Beta 트랙)
    upload_to_play_store(
      track: 'beta',
      aab: lane_context[SharedValues::GRADLE_AAB_OUTPUT_PATH],
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      skip_upload_apk: true,
      json_key_data: ENV["GOOGLE_PLAY_SERVICE_ACCOUNT_JSON"],
      package_name: "dev.eatsteak.ssurf",
      release_status: "completed"
    )

    UI.success("✅ Beta 트랙 업로드 완료!")
  end

  desc "Google Play Console Production 트랙에 배포"
  lane :release do
    # AAB 빌드
    gradle(
      task: "bundle",
      build_type: "Release",
      project_dir: "./android"
    )

    # Google Play Console에 업로드 (Production 트랙)
    # rollout_fraction을 사용하여 단계적 출시 가능 (예: 0.1 = 10%)
    upload_to_play_store(
      track: 'production',
      aab: lane_context[SharedValues::GRADLE_AAB_OUTPUT_PATH],
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      skip_upload_apk: true,
      json_key_data: ENV["GOOGLE_PLAY_SERVICE_ACCOUNT_JSON"],
      package_name: "dev.eatsteak.ssurf",
      release_status: "completed"
      # rollout_fraction: 0.1 # 10% 단계적 출시 (필요시 주석 해제)
    )

    UI.success("✅ Production 트랙 업로드 완료!")
  end
end
