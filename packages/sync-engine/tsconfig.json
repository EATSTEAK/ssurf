{
  "compilerOptions": {
    "declaration": true,
    "exactOptionalPropertyTypes": true,
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "rootDir": "src",
    "strict": true,
    "target": "ES2022"
  },
  "exclude": ["src/**/*.test.ts"],
  "include": ["src/**/*.ts"]
}
